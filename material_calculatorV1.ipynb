        "def density_calculator(mass, volume):\n",
        "    density = mass / volume\n",
        "    return density\n",
        "def volume_calculator(length, width, height):\n",
        "    volume = length * width * height\n",
        "    return volume\n",
        "def temperature_converter(celsius):\n",
        "    kelvin = (celsius + 273.15)\n",
        "    return kelvin\n",
        "def mass_fraction(component_mass, total_mass):\n",
        "    fraction = component_mass/ total_mass\n",
        "    return fraction\n",
        "def porosity_calculator(bulk_density, true_density):\n",
        "    porosity = 1 - (bulk_density / true_density)\n",
        "    return porosity\n"
      ],
