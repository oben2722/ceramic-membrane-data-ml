    {
      "cell_type": "code",
      "source": [
        "# ==================================================\n",
        "# CERAMIC MATERIALS LABORATORY TOOLKIT\n",
        "# Version: 1.0\n",
        "# Application: Materials Engineering\n",
        "# ==================================================\n",
        "\n",
        "sample_code = \"CER-001\"\n",
        "material_name = \"Alumina-based ceramic\"\n",
        "\n",
        "print(\"CERAMIC MATERIALS LABORATORY TOOLKIT\")\n",
        "print(f\"Sample: {sample_code}\")\n",
        "print(f\"Material: {material_name}\")\n",
        "\n",
        "def density_calculator(mass, volume):\n",
        "    if mass < 0 or volume <= 0:\n",
        "        return None\n",
        "    return mass / volume\n",
        "\n",
        "\n",
        "def porosity_calculator(bulk_density, true_density):\n",
        "    if true_density <= 0:\n",
        "        return None\n",
        "    if bulk_density < 0 or bulk_density > true_density:\n",
        "        return None\n",
        "    return (1 - bulk_density / true_density) * 100\n",
        "\n",
        "\n",
        "def mass_fraction(component_mass, total_mass):\n",
        "    if total_mass <= 0:\n",
        "        return None\n",
        "    if component_mass < 0 or component_mass > total_mass:\n",
        "        return None\n",
        "    return (component_mass / total_mass) * 100\n",
        "\n",
        "\n",
        "def temperature_converter(celsius):\n",
        "    return celsius + 273.15\n",
        "\n",
        "\n",
        "def volume_calculator(length, width, height):\n",
        "    if length <= 0 or width <= 0 or height <= 0:\n",
        "        return None\n",
        "    return length * width * height\n",
        "\n",
        "\n",
        "def quality_control(porosity, temperature):\n",
        "    # Evaluate specifications\n",
        "    porosity_ok = 20 <= porosity <= 40\n",
        "    temperature_ok = 1100 <= processing_temperature <= 1400\n",
        "\n",
        "    # Display messages\n",
        "    if porosity_ok:\n",
        "        print(\"Porosity within specification\")\n",
        "    else:\n",
        "        print(\"Porosity not within specification\")\n",
        "\n",
        "    if temperature_ok:\n",
        "        print(\"Temperature within specification\")\n",
        "    else:\n",
        "        print(\"Temperature not within specification\")\n",
        "\n",
        "    # Return the overall sample status\n",
        "    if porosity_ok and temperature_ok:\n",
        "        return \"Sample is satisfactory\"\n",
        "    else:\n",
        "        return \"Sample is not satisfactory\"\n",
        "\n",
        "\n",
        "sample_mass = 60\n",
        "sample_volume = 25\n",
        "\n",
        "bulk_density = 2.4\n",
        "true_density = 4.0\n",
        "\n",
        "kaolin_mass = 60\n",
        "total_batch_mass = 100\n",
        "\n",
        "processing_temperature = 1200\n",
        "density = density_calculator(sample_mass, sample_volume)\n",
        "porosity_percentage = porosity_calculator(bulk_density, true_density)\n",
        "mass_fraction_kaolin = mass_fraction(kaolin_mass, total_batch_mass)\n",
        "temperature_kelvin = temperature_converter(processing_temperature)\n",
        "\n",
        "print(\"-\" * 30)\n",
        "Quality_status = quality_control(porosity_percentage, temperature_kelvin)\n",
        "print(\"-\" * 30)\n",
        "print(f\"Density: {density:.2f} g/cm^3\")\n",
        "print(f\"Porosity: {porosity_percentage:.2f}%\")\n",
        "print(f\"Mass Fraction of Kaolin: {mass_fraction_kaolin:.2f}%\")\n",
        "print(f\"Temperature: {temperature_kelvin:.2f} K\")\n",
        "print(f\"Quality Status: {Quality_status}\")"
      ],
